#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Before weston starts, as root: waits for the pvg card, takes the scale the
# host gives by fw_cfg (opt/com.ruxn.guesthouse/scale, 1 or 2, as the Mac
# app gives it; else 1 for a first mode narrower than 2000 pixels, 2 for a
# wider one), and writes /run/guesthouse/weston.ini and session.env for
# weston-session. After three ends of weston within 20 s of their starts it
# takes the pixman renderer, so a broken GL still leaves a desktop.
set -u
run=/run/guesthouse
mkdir -p "$run"
say() { echo "guesthouse-desktop: $*"; }

card=
for i in $(seq 100); do
	for c in /sys/class/drm/card[0-9]*; do
		case $c in *-*) continue ;; esac
		if [ "$(basename "$(readlink "$c/device/driver" 2>/dev/null)")" = pvg ]; then
			card=$(basename "$c")
			break 2
		fi
	done
	[ $i = 1 ] && modprobe pvg 2>/dev/null
	sleep 0.1
done
[ -n "$card" ] || say "no card of pvg's in /sys/class/drm; weston takes the first card"

modprobe qemu_fw_cfg 2>/dev/null
# The Mac's keyboard layout as the app gives it (opt/com.ruxn.guesthouse/keyboard,
# XKB's layout and variant: "de", "ch fr"); German, as before, when it gives none.
layout=de
variant=
kb=/sys/firmware/qemu_fw_cfg/by_name/opt/com.ruxn.guesthouse/keyboard/raw
if [ -r "$kb" ]; then
	read -r l v < "$kb"
	case "$l$v" in '' | *[!a-z]*) say "the host's keyboard \"$l $v\" is no layout" ;; *) layout=$l variant=$v ;; esac
fi
scale=
fw=/sys/firmware/qemu_fw_cfg/by_name/opt/com.ruxn.guesthouse/scale/raw
if [ -r "$fw" ]; then
	scale=$(tr -d ' \n' < "$fw")
	case $scale in 1 | 2) from="the host's fw_cfg" ;; *) say "the host's scale \"$scale\" is not 1 or 2"; scale= ;; esac
fi
if [ -z "$scale" ]; then
	mode=
	for connector in /sys/class/drm/"${card:-card0}"-*; do
		[ "$(cat "$connector/status" 2>/dev/null)" = connected ] || continue
		mode=$(head -1 "$connector/modes" 2>/dev/null)
		[ -n "$mode" ] && break
	done
	width=${mode%%x*}
	case $width in
	'' | *[!0-9]*) scale=1; from="no mode read" ;;
	*) if [ "$width" -lt 2000 ]; then scale=1; else scale=2; fi; from="the mode $mode" ;;
	esac
fi

# Quick ends: the time of each start is kept; three within 20 s each of the
# one before, and the renderer is pixman until the next boot.
now=$(cut -d. -f1 /proc/uptime)
renderer=gl
[ -f "$run/renderer" ] && renderer=$(cat "$run/renderer")
if [ -f "$run/last-start" ]; then
	last=$(cat "$run/last-start")
	quick=$(cat "$run/quick" 2>/dev/null || echo 0)
	if [ $((now - last)) -lt 20 ]; then quick=$((quick + 1)); else quick=0; fi
	echo "$quick" > "$run/quick"
	if [ "$quick" -ge 3 ] && [ "$renderer" = gl ]; then
		renderer=pixman
		echo pixman > "$run/renderer"
		say "weston ended three times quickly with GL: pixman from now on"
	fi
fi
echo "$now" > "$run/last-start"

sed -e "s/^scale=.*/scale=$scale/" -e "s/^renderer=.*/renderer=$renderer/" \
	-e "s/^keymap_layout=.*/keymap_layout=$layout/" -e "s/^keymap_variant=.*/keymap_variant=$variant/" \
	/etc/guesthouse/weston.ini > "$run/weston.ini"
{
	echo "GUESTHOUSE_CARD=$card"
	echo "GUESTHOUSE_RENDERER=$renderer"
} > "$run/session.env"
chmod 644 "$run/weston.ini" "$run/session.env"
chvt 7 2>/dev/null
say "card ${card:-none}, scale $scale from $from, renderer $renderer, keyboard $layout${variant:+ $variant}"
exit 0
