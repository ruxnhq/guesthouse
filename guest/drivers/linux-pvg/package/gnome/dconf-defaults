# Guesthouse: defaults for every account; an account's own settings win.
# 00-scale and 00-keyboard beside this file are written at each boot from the
# Mac app's scale and keyboard layout.

# The screen is a window on the Mac: no blanking, no lock after a pause.
[org/gnome/desktop/session]
idle-delay=uint32 0

[org/gnome/desktop/screensaver]
lock-enabled=false

[org/gnome/shell]
favorite-apps=['org.gnome.Nautilus.desktop', 'org.gnome.Ptyxis.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Settings.desktop']
