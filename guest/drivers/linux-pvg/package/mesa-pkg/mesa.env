# Guesthouse: what weston and its clients are started with on the pvg device
# (guesthouse-desktop reads it). EGL, GBM and Vulkan find our Mesa without a
# variable; these are settings.
# Zink warns at every start of what our Vulkan driver lacks (custom border
# colours: Metal has three fixed ones). ZINK_DEBUG= on a program shows it.
ZINK_DEBUG=quiet
MESA_SHADER_CACHE_DISABLE=true
