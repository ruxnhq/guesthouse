#!/bin/sh
# Back to weston: SDDM off, weston's unit on again.
set -e
case $1 in
remove | deconfigure)
	account=$(head -1 /etc/guesthouse/desktop-user 2>/dev/null || true)
	rm -f /etc/guesthouse/desktop /etc/sddm.conf.d/guesthouse.conf
	systemctl disable sddm.service || true
	if [ -n "$account" ]; then
		systemctl disable "guesthouse-plasma-prepare@$account.service" "guesthouse-plasma-up@$account.service" || true
		systemctl enable "guesthouse-desktop@$account.service" || true
	fi
	;;
esac
