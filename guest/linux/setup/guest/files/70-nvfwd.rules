# The session and everything in it open these as the desktop user. A guest has one user, and the host's allow
# list is what guards the GPU, so these stay open.
KERNEL=="nvidiactl|nvidia[0-9]*|nvidia-uvm|nvidia-modeset", MODE="0666"
SUBSYSTEM=="drm", KERNEL=="card[0-9]*|renderD[0-9]*", MODE="0666"
# The viewer's keys and pointer port is the desktop user's alone; first-boot.sh adds that rule with the user's name.
